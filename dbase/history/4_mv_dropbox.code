find "$SRC1/2014" -type f | wc -l          # source
find images4/photos/2014 -type f | wc -l   # destination, before
# after the copy, destination should be: before + (source - skipped duplicates)


--  2026104 rsync copied files from dropbox folders to photos folder
--  the following sql updated the photos4.db accordingly
--  then the original dropbox folders were deleted

BEGIN;

CREATE TEMP TABLE mv AS
SELECT img_id, path AS old_path,
       replace(replace(path,
         '/images4/Dropbox_2021_imac/Dropbox/',          '/images4/photos/'),
         '/images4/macbook2012/Dropbox/Camera Uploads/', '/images4/photos/') AS new_path
FROM fotos
WHERE status = 'ok'
  AND (path LIKE '%/images4/Dropbox_2021_imac/Dropbox/%'
    OR path LIKE '%/images4/macbook2012/Dropbox/Camera Uploads/%');

SELECT count(*) FROM mv;                  -- expect 238; ROLLBACK if not

INSERT INTO actions (action, info, status, status_dt, img_id)
SELECT 'mv', old_path || ' -> ' || new_path, 'done', datetime('now'), img_id
FROM mv;

UPDATE fotos
SET path = (SELECT new_path FROM mv WHERE mv.img_id = fotos.img_id)
WHERE img_id IN (SELECT img_id FROM mv);

COMMIT;

